@@ -0,0 +1,16 @@
+import json, subprocess, sys, tempfile, unittest, zipfile
+from pathlib import Path
+
+class QuietTests(unittest.TestCase):
+    def test_quiet_success_and_error(self):
+        with tempfile.TemporaryDirectory() as d:
+            artifact=Path(d)/'sample.zip'
+            with zipfile.ZipFile(artifact,'w') as z: z.writestr('app.py','print(1)')
+            r=subprocess.run([sys.executable,'-m','ziptrial','inspect',str(artifact),'--quiet'],capture_output=True,text=True)
+            self.assertEqual(r.returncode,0,r.stderr)
+            self.assertEqual(r.stdout,'')
+            artifact.write_bytes(b'not an archive')
+            r=subprocess.run([sys.executable,'-m','ziptrial','inspect',str(artifact),'--quiet'],capture_output=True,text=True)
+            self.assertEqual(r.returncode,2)
+            self.assertIn('ZipTrial:',r.stderr)
+            self.assertEqual(r.stdout,'')
